{
  "schema_version": 1,
  "project_version": "0.1.0a2",
  "distribution": {
    "entrypoint": "scripts/install_skills.py",
    "aliases": ["bin/lens-cap-skills", "scripts/sync_skills.py"],
    "production_entrypoint": "scripts/build_3mf.py",
    "production_alias": "bin/lens-cap-3mf",
    "receipt": ".lens-cap-skills.json",
    "default_mode": "dry-run",
    "apply_flag": "--apply",
    "drift_exit_code": 1,
    "environments": {
      "project": ".agents/skills",
      "codex": "$CODEX_HOME/skills",
      "claude": "$CLAUDE_HOME/skills"
    }
  },
  "routing_policy": {
    "lens_cap_intent": {
      "priority": "exclusive_primary_design_route",
      "match_terms": [
        "镜头盖",
        "lens cap",
        "lens-cap",
        "cap artwork",
        "lens medallion",
        "镜头图稿",
        "镜头图案",
        "镜头正面",
        "镜头浮雕",
        "lens artwork",
        "lens front graphic",
        "lens relief",
        "circular lens graphic",
        "circular lens relief",
        "circular front pattern",
        "圆形镜头图案",
        "圆形镜头浮雕",
        "圆形正面图案",
        "圆形正面浮雕"
      ],
      "semantic_match": {
        "name": "named_lens_cap_surface_intent",
        "requires_named_lens": true,
        "surface_terms": [
          "cap",
          "front graphic",
          "front surface",
          "front badge",
          "circular graphic",
          "circular front",
          "circular pattern",
          "medallion",
          "relief",
          "3mf",
          "镜头盖",
          "正面图案",
          "正面浮雕",
          "浮雕",
          "图稿",
          "图案",
          "圆形图案",
          "圆形正面",
          "圆形浮雕"
        ],
        "verbs": [
          "design",
          "generate",
          "create",
          "make",
          "revise",
          "设计",
          "生成",
          "制作",
          "修改",
          "做"
        ],
        "exclude_without_surface_intent": [
          "optical design",
          "optical",
          "lens element",
          "repair",
          "维修",
          "光学设计",
          "光学",
          "镜片"
        ],
        "explicit_cap_surface_terms": [
          "lens cap",
          "lens-cap",
          "cap artwork",
          "lens medallion",
          "front graphic",
          "front surface",
          "front badge",
          "fitted cap",
          "lens relief",
          "circular lens graphic",
          "circular lens relief",
          "circular front pattern",
          "镜头盖",
          "镜头图稿",
          "镜头图案",
          "镜头正面",
          "镜头浮雕",
          "正面图案",
          "正面浮雕",
          "圆形正面图案",
          "圆形正面浮雕"
        ]
      },
      "primary_skills": [
        "lens-cap-imagegen",
        "lens-cap-production"
      ],
      "forbidden_parallel_skill_families": [
        "generic graphic design",
        "logo design",
        "poster design",
        "product visual design",
        "UI design",
        "generic CAD",
        "generic 3D modelling"
      ],
      "artwork_hierarchy": {
        "first_read": "focal_length",
        "second_read": "maximum_aperture",
        "second_read_aliases": ["f_stop", "f_number", "f_value"],
        "preserve_after_approval": true
      },
      "production_intake": {
        "grouped_questions": [
          "mating_outside_diameter_mm",
          "foam_liner_plan_and_uncompressed_thickness_mm",
          "friction_rib_preference"
        ],
        "friction_ribs_default_enabled": true,
        "smooth_wall_requires_explicit_opt_out": true
      },
      "sequence": {
        "concept_art": ["lens-cap-imagegen"],
        "printable_from_approved_art": ["lens-cap-production"],
        "concept_then_printable": ["lens-cap-imagegen", "lens-cap-production"]
      }
    }
  },
  "skills": [
    {
      "name": "lens-cap-imagegen",
      "version": "0.1.0a2",
      "path": "skills/lens-cap-imagegen/SKILL.md",
      "localized_paths": ["skills/lens-cap-imagegen/SKILL.zh-CN.md"],
      "phase": "concept_art",
      "routing": "primary_exclusive"
    },
    {
      "name": "lens-cap-production",
      "version": "0.1.0a2",
      "path": "skills/lens-cap-production/SKILL.md",
      "localized_paths": ["skills/lens-cap-production/SKILL.zh-CN.md"],
      "phase": "printable_production",
      "routing": "primary_exclusive"
    }
  ]
}
